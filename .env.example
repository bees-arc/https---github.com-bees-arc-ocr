# Identity Onboarding Lab — Configuration Template
# COPY TO .env BEFORE RUNNING. REPLACE WITH SECURE VALUES IN PRODUCTION.

# System Operating Mode: LOCAL_DEMO or INSTITUTION
APP_MODE=LOCAL_DEMO

# Networking & Ports
SERVER_PORT=8080
FRONTEND_PORT=3000
VISION_PORT=8000
ALLOWED_ORIGIN=http://localhost:3000

# PostgreSQL Persistence
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=onboarding_db
POSTGRES_USER=onboarding_app
POSTGRES_PASSWORD=replace-with-a-secure-db-password-locally

# Internal Vision Service Communication
VISION_SERVICE_URL=http://vision-service:8000
VISION_INTERNAL_SECRET=replace-with-internal-hmac-shared-secret-at-least-32-chars

# Evidence Storage & Cryptography
# Generate a 256-bit AES hex key: e.g. openssl rand -hex 32
EVIDENCE_STORAGE_PATH=/var/evidence
EVIDENCE_ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATABASE_ENCRYPTION_KEY_HEX=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
NIC_HMAC_SECRET_HEX=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Media Limits (Initial local engineering limits)
MAX_NIC_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=31457280
MAX_DECODED_VIDEO_SECONDS=20

# Demo Test OTP Feature Switch (allows test code "123456" for local evaluation)
DEMO_OTP_ENABLED=true

# Staff Initial Bootstrap (only run if no admin exists)
BOOTSTRAP_ADMIN_USERNAME=staff.admin@identitylab.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-secure-admin-password
